# ESP-IDF default configuration for the medication dispenser sensor node.
# Applied when no sdkconfig exists (fresh clone / after deleting sdkconfig).

# Bluetooth: NimBLE host only (Design Document, Chapter 2, Section 2.2)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Board has 4 MB flash (detected by the bootloader)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Only one central (Raspberry Pi) at a time
# (Design Document, Chapter 6, Section 6.2, Requirement 4.8)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
